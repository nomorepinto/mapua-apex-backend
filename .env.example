APP_NAME="Mapua APEX"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shared IAM credentials for DynamoDB, S3, and SES (leave empty to use the instance role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Optional LocalStack/custom endpoint for all AWS SDK clients. Leave empty for real AWS.
AWS_ENDPOINT=

# S3 (wired; unused until PDF storage)
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_S3_PDF_PREFIX=pdfs

# Cognito (JWT verification only — pool id + SPA app client id)
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

# DynamoDB (single-table name from the other AWS project)
AWS_DYNAMODB_TABLE=
# Optional DynamoDB-only endpoint (defaults to AWS_ENDPOINT)
DYNAMODB_ENDPOINT=

API_TOKEN_STUDENT=
API_TOKEN_SIGNATORY=
API_TOKEN_ADMIN=

# Campus-wide desks (plain uuid or SIGNATORY#uuid from POST /admins/signatories).
# PUT the same id to rename the person; do not mint a new uuid.
OSAAR_SIGNATORY_ID=
CDM_SIGNATORY_ID=

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"
